NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/player_issue_intelligence?replicaSet=rs0
CORS_ORIGINS=*
JWT_SECRET=replace-with-at-least-32-random-characters
AI_SERVICE_URL=http://127.0.0.1:4001
AI_INTERNAL_TOKEN=must-match-ai-service-token
ENABLE_LEGACY_INGESTION=false
# Optional Discord relay (npm run discord)
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_SOURCE_ID=
DISCORD_WEBHOOK_TOKEN=
CORE_API_URL=http://127.0.0.1:4000
