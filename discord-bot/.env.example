# ========================================================
# Player Issue Intelligence - Standalone Discord Bot Relay
# ========================================================

# 1. Discord Bot Token (from https://discord.com/developers/applications -> Your App -> Bot -> Reset/Copy Token)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# 2. Discord Channel ID where players write feedback/bug reports (Right click channel -> Copy Channel ID)
DISCORD_CHANNEL_ID=your_discord_channel_id_here

# 3. Connection Credentials from Dashboard (Feedback -> + Add source -> Discord)
DISCORD_SOURCE_ID=your_source_id_here
DISCORD_WEBHOOK_TOKEN=your_webhook_token_here

# 4. Backend Core API URL
CORE_API_URL=http://127.0.0.1:4000